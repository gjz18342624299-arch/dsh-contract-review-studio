{
  "name": "dsh-contract-review-studio",
  "version": "0.10.5",
  "private": true,
  "type": "module",
  "description": "合同审查工作台 · 本地方案版",
  "license": "MIT",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "public",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.txt",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjz18342624299-arch/dsh-contract-review-studio.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
